  <!-- Create clean __depot/build folders for distribution -->
  <Target Name="CreateDepotFolders" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Creating __depot folders for distribution..." Importance="high" />
    <PropertyGroup>
      <DepotPath>$(SolutionDir)__depot\build</DepotPath>
      <DepotCompilerPath>$(DepotPath)\t7compiler</DepotCompilerPath>
      <DepotGuiPath>$(DepotPath)\t7gui</DepotGuiPath>
    </PropertyGroup>
    <!-- Clear existing __depot\build folder if it exists -->
    <!-- Skip cleanup if files are locked (build might still work) -->
    <Message Text="Cleaning up depot folder (skipping if files are locked)..." Importance="normal" />
    <ItemGroup Condition="Exists('$(DepotPath)')">
      <FilesToDelete Include="$(DepotPath)\**\*" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" ContinueOnError="true" Condition="Exists('$(DepotPath)')" />
    <RemoveDir Directories="$(DepotPath)" ContinueOnError="true" Condition="Exists('$(DepotPath)')" />
    <!-- Create directories -->
    <MakeDir Directories="$(DepotPath)" />
    <MakeDir Directories="$(DepotCompilerPath)" />
    <MakeDir Directories="$(DepotGuiPath)" />
    <!-- Create clean GUI folder -->
    <PropertyGroup>
      <GuiSourcePath>$(SolutionDir)T7CompilerGUI\bin\x64\Release</GuiSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(GuiSourcePath)')">
      <GuiSourcePath>$(SolutionDir)T7CompilerGUI\bin\x64\Debug</GuiSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(GuiSourcePath)')">
      <GuiSourcePath>$(SolutionDir)T7CompilerGUI\bin\Release</GuiSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(GuiSourcePath)')">
      <GuiSourcePath>$(SolutionDir)T7CompilerGUI\bin\Debug</GuiSourcePath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(GuiSourcePath)')">
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.exe" />
      <!-- DLLs are embedded with Costura, so we don't copy them -->
      <!-- Copy database files - required for compilation -->
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.db" />
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.db2" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.xml" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.pdb" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.dll.config" />
    </ItemGroup>
    <Copy SourceFiles="@(GuiFilesToCopy)" DestinationFolder="$(DepotGuiPath)" SkipUnchangedFiles="true" Condition="Exists('$(GuiSourcePath)')" />
    <!-- Create clean compiler folder -->
    <PropertyGroup>
      <CompilerSourcePath>$(SolutionDir)DebugCompiler\bin\Release</CompilerSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(CompilerSourcePath)')">
      <CompilerSourcePath>$(SolutionDir)DebugCompiler\bin\Debug</CompilerSourcePath>
    </PropertyGroup>
    <!-- Copy compiler files if source exists -->
    <Message Text="Checking for compiler source path: $(CompilerSourcePath)" Importance="normal" />
    <ItemGroup Condition="Exists('$(CompilerSourcePath)')">
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.exe" />
      <!-- DLLs are embedded with Costura, so we don't copy them -->
      <!-- Copy database files - required for compilation -->
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.db" />
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.db2" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.xml" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.pdb" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.dll.config" />
    </ItemGroup>
    <Message Text="Copying compiler files from $(CompilerSourcePath) to $(DepotCompilerPath) - Found @(CompilerFilesToCopy-&gt;Count()) files" Condition="Exists('$(CompilerSourcePath)')" Importance="normal" />
    <Message Text="ERROR: Compiler source path does not exist: $(CompilerSourcePath). t7compiler folder will be empty!" Condition="!Exists('$(CompilerSourcePath)')" Importance="high" />
    <Copy SourceFiles="@(CompilerFilesToCopy)" DestinationFolder="$(DepotCompilerPath)" SkipUnchangedFiles="true" Condition="Exists('$(CompilerSourcePath)') and '@(CompilerFilesToCopy)' != ''" />
    <!-- Verify files were copied -->
    <ItemGroup>
      <CompilerCopiedFiles Include="$(DepotCompilerPath)\*" />
    </ItemGroup>
    <Message Text="Compiler installation complete: @(CompilerCopiedFiles-&gt;Count()) files in $(DepotCompilerPath)" Importance="normal" />
    <!-- Internal DLLs are now embedded with Costura, so we don't copy them separately -->
    <!-- Create update.zip package using MSBuild ZipDirectory task (available in .NET SDK) -->
    <PropertyGroup>
      <UpdateZipPath>$(DepotPath)\..\update.zip</UpdateZipPath>
    </PropertyGroup>
    <!-- Delete existing zip if it exists -->
    <Delete Files="$(UpdateZipPath)" Condition="Exists('$(UpdateZipPath)')" />
    <!-- Copy default project into __depot/build/defaultproject -->
    <PropertyGroup>
      <DefaultProjectPath>$(SolutionDir)Default Project</DefaultProjectPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(DefaultProjectPath)')">
      <DefaultProjectFiles Include="$(DefaultProjectPath)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DefaultProjectFiles)" DestinationFolder="$(DepotPath)\defaultproject\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(DefaultProjectPath)')" />
    <!-- Copy VSIX files into __depot/build/ -->
    <ItemGroup>
      <VsixFiles Include="$(SolutionDir)*.vsix" />
    </ItemGroup>
    <Copy SourceFiles="@(VsixFiles)" DestinationFolder="$(DepotPath)" SkipUnchangedFiles="true" />
    <!-- Copy installer to __depot/ -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DepotPath)\.." SkipUnchangedFiles="true" />
    <!-- Verify folders exist and have files before creating zip -->
    <Message Text="Verifying folders before creating zip..." Importance="normal" />
    <ItemGroup>
      <T7CompilerFiles Include="$(DepotCompilerPath)\*" />
      <T7GuiFiles Include="$(DepotGuiPath)\*" />
      <DefaultProjectFiles Include="$(DepotPath)\defaultproject\**\*" />
    </ItemGroup>
    <Message Text="t7compiler has @(T7CompilerFiles-&gt;Count()) files" Importance="normal" />
    <Message Text="t7gui has @(T7GuiFiles-&gt;Count()) files" Importance="normal" />
    <Message Text="defaultproject has @(DefaultProjectFiles-&gt;Count()) files" Importance="normal" />
    <!-- Create ZIP file from __depot/build folder using PowerShell -->
    <!-- Add a small delay to ensure files are closed before zipping -->
    <!-- Use -Recurse to include empty folders if needed -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (Test-Path '$(DepotPath)') { Start-Sleep -Milliseconds 500; $items = Get-ChildItem '$(DepotPath)' -Directory; if ($items) { Compress-Archive -Path '$(DepotPath)\*' -DestinationPath '$(UpdateZipPath)' -Force -CompressionLevel Optimal } else { Write-Error 'No directories found in $(DepotPath)' } }&quot;" Condition="Exists('$(DepotPath)')" IgnoreExitCode="false" />
  </Target>
