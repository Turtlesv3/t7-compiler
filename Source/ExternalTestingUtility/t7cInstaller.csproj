  <!-- Create clean __depot/build folders for distribution -->
  <!-- Run on all configurations, but can be disabled by setting SkipDepotCreation=true -->
  <Target Name="CreateDepotFolders" AfterTargets="AfterBuild" Condition="'$(SkipDepotCreation)' != 'true'">
    <Message Text="Creating __depot folders for distribution..." Importance="high" />
    <PropertyGroup>
      <!-- SolutionDir is the directory containing the .sln file, which is Source\ -->
      <!-- Builds is at the root level (My T7\Builds), Resources is in Source (My T7\Source\Resources) -->
      <DepotPath>$(SolutionDir)__depot\build</DepotPath>
      <DepotCompilerPath>$(DepotPath)\t7compiler</DepotCompilerPath>
      <DepotGuiPath>$(DepotPath)\t7gui</DepotGuiPath>
      <!-- Builds folder is at root level (same as SolutionDir) -->
      <BuildsPath>$(SolutionDir)Builds</BuildsPath>
      <!-- Resources folder is at root level (same as SolutionDir) -->
      <ResourcesPath>$(SolutionDir)Resources</ResourcesPath>
    </PropertyGroup>
    <Message Text="SolutionDir: $(SolutionDir)" Importance="normal" />
    <Message Text="SolutionDirFullPath: $(_SolutionDirFullPath)" Importance="normal" />
    <Message Text="BuildsPath: $(BuildsPath)" Importance="normal" />
    <!-- Create directories first (they may already exist from T7CompilerGUI's CopyToDepot) -->
    <MakeDir Directories="$(DepotPath)" />
    <MakeDir Directories="$(DepotCompilerPath)" />
    <MakeDir Directories="$(DepotGuiPath)" />
    <!-- Only clean specific subfolders, not the entire depot (T7CompilerGUI may have already copied files) -->
    <!-- Clean compiler folder only (GUI folder should be preserved if T7CompilerGUI already copied to it) -->
    <Message Text="Cleaning up depot compiler folder (skipping if files are locked)..." Importance="normal" />
    <ItemGroup Condition="Exists('$(DepotCompilerPath)')">
      <CompilerFilesToDelete Include="$(DepotCompilerPath)\**\*" />
    </ItemGroup>
    <Delete Files="@(CompilerFilesToDelete)" ContinueOnError="true" Condition="Exists('$(DepotCompilerPath)')" />
    <RemoveDir Directories="$(DepotCompilerPath)" ContinueOnError="true" Condition="Exists('$(DepotCompilerPath)')" />
    <MakeDir Directories="$(DepotCompilerPath)" />
    <!-- Create clean GUI folder - respect build configuration -->
    <!-- First check if GUI was already copied to __depot by T7CompilerGUI's CopyToDepot target -->
    <PropertyGroup>
      <DepotGuiCheckPath>$(DepotGuiPath)</DepotGuiCheckPath>
    </PropertyGroup>
    <Message Text="Checking for GUI in __depot first: $(DepotGuiCheckPath)" Importance="normal" />
    <PropertyGroup Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe')">
      <!-- Not in depot, check Builds folder - try current configuration first (without x64) -->
      <GuiSourcePath>$([System.IO.Path]::Combine($(BuildsPath), 'T7CompilerGUI', '$(Configuration)'))</GuiSourcePath>
    </PropertyGroup>
    <Message Text="Trying GUI path (current config): $(GuiSourcePath)" Importance="normal" Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe')" />
    <PropertyGroup Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)')">
      <!-- Try x64 subfolder for current config -->
      <GuiSourcePath>$([System.IO.Path]::Combine($(BuildsPath), 'T7CompilerGUI', 'x64', '$(Configuration)'))</GuiSourcePath>
    </PropertyGroup>
    <Message Text="Trying GUI path (x64 current config): $(GuiSourcePath)" Importance="normal" Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)')" />
    <PropertyGroup Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)')">
      <!-- Fallback: try Release if current config doesn't exist -->
      <GuiSourcePath Condition="'$(Configuration)' != 'Release'">$([System.IO.Path]::Combine($(BuildsPath), 'T7CompilerGUI', 'Release'))</GuiSourcePath>
    </PropertyGroup>
    <Message Text="Trying GUI path (Release fallback): $(GuiSourcePath)" Importance="normal" Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)') AND '$(Configuration)' != 'Release'" />
    <PropertyGroup Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)')">
      <!-- Last resort: try x64 Release -->
      <GuiSourcePath Condition="'$(Configuration)' != 'Release'">$([System.IO.Path]::Combine($(BuildsPath), 'T7CompilerGUI', 'x64', 'Release'))</GuiSourcePath>
    </PropertyGroup>
    <Message Text="Trying GUI path (x64 Release fallback): $(GuiSourcePath)" Importance="normal" Condition="!Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe') AND !Exists('$(GuiSourcePath)') AND '$(Configuration)' != 'Release'" />
    <!-- Use depot if GUI is already there, otherwise use Builds folder -->
    <PropertyGroup Condition="Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe')">
      <GuiSourcePath>$(DepotGuiCheckPath)</GuiSourcePath>
    </PropertyGroup>
    <Message Text="GUI already in depot, using: $(GuiSourcePath)" Importance="normal" Condition="Exists('$(DepotGuiCheckPath)\T7CompilerGUI.exe')" />
    <Message Text="Final GUI source path: $(GuiSourcePath)" Importance="high" />
    <Message Text="ERROR: GUI source path does not exist: $(GuiSourcePath). GUI files will not be copied!" Importance="high" Condition="!Exists('$(GuiSourcePath)')" />
    <ItemGroup Condition="Exists('$(GuiSourcePath)')">
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.exe" />
      <!-- DLLs are embedded with Costura, so we don't copy them -->
      <!-- Copy database files - required for compilation -->
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.db" />
      <GuiFilesToCopy Include="$(GuiSourcePath)\*.db2" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.xml" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.pdb" />
      <GuiFilesToCopy Remove="$(GuiSourcePath)\*.dll.config" />
    </ItemGroup>
    <Copy SourceFiles="@(GuiFilesToCopy)" DestinationFolder="$(DepotGuiPath)" SkipUnchangedFiles="true" Condition="Exists('$(GuiSourcePath)')" />
    <!-- GSC.xshd is now embedded in the executable, no need to copy it separately -->
    <!-- Always copy database files from Resources to GUI output -->
    <Message Text="ResourcesPath: $(ResourcesPath)" Importance="normal" />
    <Message Text="Checking for database files in $(ResourcesPath)..." Importance="normal" />
    <ItemGroup>
      <GuiDatabaseFilesToCopy Include="$(ResourcesPath)\T7PCV2.db" Condition="Exists('$(ResourcesPath)\T7PCV2.db')" />
      <GuiDatabaseFilesToCopy Include="$(ResourcesPath)\T7PS4V2.db" Condition="Exists('$(ResourcesPath)\T7PS4V2.db')" />
      <GuiDatabaseFilesToCopy Include="$(ResourcesPath)\vm_codes.db2" Condition="Exists('$(ResourcesPath)\vm_codes.db2')" />
    </ItemGroup>
    <Message Text="Found @(GuiDatabaseFilesToCopy->Count()) database files to copy to GUI" Importance="normal" />
    <Message Text="Database files: @(GuiDatabaseFilesToCopy)" Importance="normal" Condition="'@(GuiDatabaseFilesToCopy)' != ''" />
    <Message Text="WARNING: No database files found in $(ResourcesPath)" Importance="high" Condition="'@(GuiDatabaseFilesToCopy)' == ''" />
    <Copy SourceFiles="@(GuiDatabaseFilesToCopy)" DestinationFolder="$(DepotGuiPath)" SkipUnchangedFiles="true" Condition="'@(GuiDatabaseFilesToCopy)' != ''" />
    <!-- Create clean compiler folder - respect build configuration -->
    <PropertyGroup>
      <CompilerSourcePath>$([System.IO.Path]::Combine($(BuildsPath), 'DebugCompiler', '$(Configuration)'))</CompilerSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(CompilerSourcePath)')">
      <!-- Fallback: try Release if current config doesn't exist -->
      <CompilerSourcePath Condition="'$(Configuration)' != 'Release'">$([System.IO.Path]::Combine($(BuildsPath), 'DebugCompiler', 'Release'))</CompilerSourcePath>
    </PropertyGroup>
    <PropertyGroup Condition="!Exists('$(CompilerSourcePath)')">
      <!-- Last resort: try Debug -->
      <CompilerSourcePath Condition="'$(Configuration)' != 'Debug'">$([System.IO.Path]::Combine($(BuildsPath), 'DebugCompiler', 'Debug'))</CompilerSourcePath>
    </PropertyGroup>
    <!-- Copy compiler files if source exists -->
    <Message Text="Checking for compiler source path: $(CompilerSourcePath)" Importance="normal" />
    <ItemGroup Condition="Exists('$(CompilerSourcePath)')">
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.exe" />
      <!-- DLLs are embedded with Costura, so we don't copy them -->
      <!-- Copy database files - required for compilation -->
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.db" />
      <CompilerFilesToCopy Include="$(CompilerSourcePath)\*.db2" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.xml" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.pdb" />
      <CompilerFilesToCopy Remove="$(CompilerSourcePath)\*.dll.config" />
    </ItemGroup>
    <Message Text="Copying compiler files from $(CompilerSourcePath) to $(DepotCompilerPath) - Found @(CompilerFilesToCopy->Count()) files" Condition="Exists('$(CompilerSourcePath)')" Importance="normal" />
    <Message Text="ERROR: Compiler source path does not exist: $(CompilerSourcePath). t7compiler folder will be empty!" Condition="!Exists('$(CompilerSourcePath)')" Importance="high" />
    <Copy SourceFiles="@(CompilerFilesToCopy)" DestinationFolder="$(DepotCompilerPath)" SkipUnchangedFiles="true" Condition="Exists('$(CompilerSourcePath)') and '@(CompilerFilesToCopy)' != ''" />
    <!-- Always copy database files from Resources to compiler output -->
    <Message Text="Checking for database files in $(ResourcesPath)..." Importance="normal" />
    <ItemGroup>
      <DatabaseFilesToCopy Include="$(ResourcesPath)\T7PCV2.db" Condition="Exists('$(ResourcesPath)\T7PCV2.db')" />
      <DatabaseFilesToCopy Include="$(ResourcesPath)\T7PS4V2.db" Condition="Exists('$(ResourcesPath)\T7PS4V2.db')" />
      <DatabaseFilesToCopy Include="$(ResourcesPath)\vm_codes.db2" Condition="Exists('$(ResourcesPath)\vm_codes.db2')" />
    </ItemGroup>
    <Message Text="Found @(DatabaseFilesToCopy->Count()) database files to copy to compiler" Importance="normal" />
    <Message Text="Database files: @(DatabaseFilesToCopy)" Importance="normal" Condition="'@(DatabaseFilesToCopy)' != ''" />
    <Message Text="WARNING: No database files found in $(ResourcesPath)" Importance="high" Condition="'@(DatabaseFilesToCopy)' == ''" />
    <Copy SourceFiles="@(DatabaseFilesToCopy)" DestinationFolder="$(DepotCompilerPath)" SkipUnchangedFiles="true" Condition="'@(DatabaseFilesToCopy)' != ''" />
    <!-- Verify files were copied -->
    <ItemGroup>
      <CompilerCopiedFiles Include="$(DepotCompilerPath)\*" />
    </ItemGroup>
    <Message Text="Compiler installation complete: @(CompilerCopiedFiles->Count()) files in $(DepotCompilerPath)" Importance="normal" />
    <!-- Internal DLLs are now embedded with Costura, so we don't copy them separately -->
    <!-- Create update.zip package using MSBuild ZipDirectory task (available in .NET SDK) -->
    <PropertyGroup>
      <UpdateZipPath>$(DepotPath)\..\update.zip</UpdateZipPath>
    </PropertyGroup>
    <!-- Delete existing zip if it exists (with error handling) -->
    <Delete Files="$(UpdateZipPath)" Condition="Exists('$(UpdateZipPath)')" ContinueOnError="true" />
    <!-- Note: defaultproject is created by the code editor at runtime in the exe directory, so it doesn't need to be copied here -->
    <PropertyGroup>
      <DefaultMenuPath>$([System.IO.Path]::Combine($(ResourcesPath), 'Default Menu'))</DefaultMenuPath>
    </PropertyGroup>
    <!-- Copy Default Menu folder into __depot/build/Default Menu -->
    <Message Text="Checking for Default Menu at: $(DefaultMenuPath)" Importance="normal" />
    <ItemGroup Condition="Exists('$(DefaultMenuPath)')">
      <DefaultMenuFiles Include="$(DefaultMenuPath)\**\*" />
    </ItemGroup>
    <Message Text="Found @(DefaultMenuFiles->Count()) files in Default Menu" Importance="normal" Condition="Exists('$(DefaultMenuPath)')" />
    <Message Text="WARNING: Default Menu folder not found at $(DefaultMenuPath)" Importance="high" Condition="!Exists('$(DefaultMenuPath)')" />
    <Message Text="Copying Default Menu files to $(DepotPath)\Default Menu" Importance="normal" Condition="Exists('$(DefaultMenuPath)') and '@(DefaultMenuFiles)' != ''" />
    <Copy SourceFiles="@(DefaultMenuFiles)" DestinationFolder="$(DepotPath)\Default Menu\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(DefaultMenuPath)') and '@(DefaultMenuFiles)' != ''" />
    <!-- Copy Default Menu.rar into __depot/build/ -->
    <PropertyGroup>
      <_DefaultMenuRarPath>$([System.IO.Path]::Combine($(ResourcesPath), 'Default Menu.rar'))</_DefaultMenuRarPath>
    </PropertyGroup>
    <ItemGroup>
      <DefaultMenuRar Include="$(_DefaultMenuRarPath)" Condition="Exists('$(_DefaultMenuRarPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(DefaultMenuRar)" DestinationFolder="$(DepotPath)" SkipUnchangedFiles="true" />
    <!-- Copy VSIX files into __depot/build/ -->
    <ItemGroup>
      <VsixFiles Include="$(ResourcesPath)\*.vsix" />
    </ItemGroup>
    <Copy SourceFiles="@(VsixFiles)" DestinationFolder="$(DepotPath)" SkipUnchangedFiles="true" />
    <!-- Copy installer to __depot/ -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DepotPath)\.." SkipUnchangedFiles="true" />
    <!-- Verify folders exist and have files before creating zip -->
    <Message Text="Verifying folders before creating zip..." Importance="normal" />
    <ItemGroup>
      <T7CompilerFiles Include="$(DepotCompilerPath)\*" />
      <T7GuiFiles Include="$(DepotGuiPath)\*" />
      <DefaultMenuFiles Include="$(DepotPath)\Default Menu\**\*" />
    </ItemGroup>
    <Message Text="t7compiler has @(T7CompilerFiles->Count()) files" Importance="normal" />
    <Message Text="t7gui has @(T7GuiFiles->Count()) files" Importance="normal" />
    <Message Text="Default Menu has @(DefaultMenuFiles->Count()) files" Importance="normal" />
    <!-- Create ZIP file from __depot/build folder using PowerShell -->
    <!-- Include only: Default Menu folder, t7compiler folder, t7gui folder, Default Menu.rar, and shiversoftdev.vscode-txgsc-1.0.14.vsix -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$depotPath = '$(DepotPath)'; $zipPath = '$(UpdateZipPath)'; if (-not (Test-Path $depotPath)) { Write-Error 'Depot path does not exist: ' + $depotPath; exit 1 }; Start-Sleep -Milliseconds 500; $ErrorActionPreference = 'Stop'; try { if (Test-Path $zipPath) { Remove-Item $zipPath -Force -ErrorAction SilentlyContinue }; $parentDir = Split-Path $zipPath -Parent; if (-not (Test-Path $parentDir)) { New-Item -ItemType Directory -Path $parentDir -Force | Out-Null }; $itemsToZip = @(); $itemsToZip += Get-Item (Join-Path $depotPath 'Default Menu') -ErrorAction SilentlyContinue; $itemsToZip += Get-Item (Join-Path $depotPath 't7compiler') -ErrorAction SilentlyContinue; $itemsToZip += Get-Item (Join-Path $depotPath 't7gui') -ErrorAction SilentlyContinue; $itemsToZip += Get-Item (Join-Path $depotPath 'Default Menu.rar') -ErrorAction SilentlyContinue; $itemsToZip += Get-Item (Join-Path $depotPath 'shiversoftdev.vscode-txgsc-1.0.14.vsix') -ErrorAction SilentlyContinue; $itemsToZip = $itemsToZip | Where-Object { $_ -ne $null -and (Test-Path $_.FullName) }; if ($itemsToZip.Count -eq 0) { Write-Error 'No items found to zip in: ' + $depotPath; exit 1 }; $itemsToZip | Compress-Archive -DestinationPath $zipPath -Force -CompressionLevel Optimal; Write-Host 'Created update.zip at ' + $zipPath } catch { $errorMsg = $_.ToString(); Write-Error ('Failed to create update.zip: ' + $errorMsg); exit 1 }&quot;" Condition="Exists('$(DepotPath)')" IgnoreExitCode="false" />
  </Target>
</Project>