  </Target>
  <!-- Close T7GUI if it's running during build to prevent file locking issues -->
  <!-- Run before PrepareForBuild to ensure files are unlocked before compilation starts -->
  <Target Name="CloseT7GUI" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ProcessName>T7CompilerGUI</ProcessName>
    </PropertyGroup>
    <!-- Check if process is running and close it -->
    <Exec Command="taskkill /IM $(ProcessName).exe /T /F 2&gt;nul" ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="TaskKillExitCode" />
    </Exec>
    <!-- Wait a brief moment for the process to fully close and release file locks -->
    <Exec Command="timeout /t 1 /nobreak &gt;nul 2&gt;&amp;1" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(TaskKillExitCode)' == '0'" />
    <Message Text="Closed T7GUI process if it was running" Importance="normal" Condition="'$(TaskKillExitCode)' == '0'" />
  </Target>
  <!-- Copy GUI to __depot\build\t7gui on Release builds (only .exe since everything is embedded) -->
  <!-- Run after Costura finishes embedding DLLs -->
  <Target Name="CopyToDepot" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DepotGuiPath>$(SolutionDir)__depot\build\t7gui</DepotGuiPath>
      <DefaultProjectSource>$(SolutionDir)Default Project</DefaultProjectSource>
      <DefaultProjectTarget>$(DepotGuiPath)\defaultproject</DefaultProjectTarget>
    </PropertyGroup>
    <!-- Create depot folder if it doesn't exist -->
    <MakeDir Directories="$(DepotGuiPath)" Condition="!Exists('$(DepotGuiPath)')" />
    <!-- Copy only the .exe file (everything else is embedded with Costura) -->
    <Copy SourceFiles="$(OutDir)$(TargetFileName)" DestinationFolder="$(DepotGuiPath)" SkipUnchangedFiles="true" ContinueOnError="false" />
    <Message Text="Copied $(TargetFileName) to $(DepotGuiPath)" Importance="high" />
    <!-- Copy defaultproject with T7/T8 structure if Default Project folder exists -->
    <ItemGroup Condition="Exists('$(DefaultProjectSource)')">
      <DefaultProjectFiles Include="$(DefaultProjectSource)\**\*" />
    </ItemGroup>
  </Target>
